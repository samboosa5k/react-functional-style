{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES6",
    "lib": [
      "ES6",
      "DOM",
      "DOM.Iterable",
      "esnext"
    ],
    "strict": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "outDir": "public",
    "baseUrl": ".",
    "paths": {
      "@apps/*": ["apps/*"],
      "@assets/*": ["src/assets/*"],
      "@src/*": ["src/*"],
      "@/animation/*": ["src/animation/*"],
      "@/atoms/*": ["src/atoms/*"],
      "@/molecules/*": ["src/molecules/*"],
      "@/organisms/*": ["src/organisms/*"],
      "@/templates/*": ["src/templates/*"],
      "@/theme": ["src/theme"],
      "@/theme/*": ["src/theme/*"]
    }
  },
  "include": [
    "src/**/*",
    "apps/**/*",
    "svgmodule.d.ts",
    "pngmodule.d.ts",
    "jpgmodule.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "src/stories/**/*",
    "**/*.stories.tsx"
  ]
}